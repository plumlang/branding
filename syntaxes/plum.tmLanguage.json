{
  "scopeName": "source.plum",
  "name": "Plum",
  "fileTypes": [".plum"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#constants" }
  ],
  "repository": {
"comments": {
  "name": "comment.line.double-dash.plum",
  "begin": "--",
  "end": "--"
},
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.plum",
          "match": "\\b(drop|if|else|elif|while|for|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.plum",
          "match": "\\b(let|const|var|func|class)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.plum",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.plum",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.plum",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
"operators": {
  "patterns": [
    {
      "name": "keyword.operator.plum",
      "match": "\\*\\*|//|--|\\+|-|\\*|/|%|\\^|==|!=|<=|>=|<|>|&&|\\|\\||!"
    }
  ]
},
    "functions": {
      "name": "entity.name.function.plum",
      "match": "\\b[a-zA-Z_]\\w*\\s*(?=\\()"
    },
    "constants": {
      "name": "constant.language.plum",
      "match": "\\b(good|bad|null|undefined)\\b"
    }
  }
}