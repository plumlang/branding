{
  "scopeName": "source.plum",
  "name": "Plum",
  "fileTypes": [".plum"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#types" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.plum",
          "match": "--.*$"
        },
        {
          "name": "comment.block.plum",
          "begin": "--\\[",
          "end": "\\]--"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.plum",
          "match": "\\b(drop|if|else|elif|while|for|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.plum",
          "match": "\\b(plant|root|func|class)\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.plum",
      "match": "\\b(int|float|str|bool|list|dict|any)\\b"
    },
    "strings": {
      "name": "string.quoted.double.plum",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.plum",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.plum",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.plum",
          "match": "="
        },
        {
          "name": "keyword.operator.plum",
          "match": "\\+|-|\\*|/|%|\\^|==|!=|<=|>=|<|>|&&|\\|\\||!"
        }
      ]
    },
    "functions": {
      "name": "entity.name.function.plum",
      "match": "\\b[a-zA-Z_]\\w*\\s*(?=\\()"
    },
    "constants": {
      "name": "constant.language.plum",
      "match": "\\b(true|false|null|undefined|none)\\b"
    }
  }
}