{
  "scopeName": "source.plum",
  "name": "Plum",
  "fileTypes": [".plum"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.plum",
          "match": "--.*$"
        },
        {
          "name": "comment.block.plum",
          "begin": "--\\[",
          "end": "\\]--"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.plum",
          "begin": "\\b(branch)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.function.plum" },
            "2": { "name": "storage.type.return.plum" },
            "3": { "name": "entity.name.function.plum" },
            "4": { "name": "punctuation.definition.parameters.begin.plum" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "punctuation.definition.parameters.end.plum" }
          },
          "patterns": [
            { "include": "#function-parameters" }
          ]
        },
        {
          "name": "meta.function-call.plum",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.plum" },
            "2": { "name": "punctuation.definition.arguments.begin.plum" }
          }
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "name": "variable.parameter.plum",
          "match": "\\b(int|str|bool|float|void|list|dict|any)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.parameter.plum" },
            "2": { "name": "variable.parameter.plum" }
          }
        },
        {
          "name": "punctuation.separator.parameters.plum",
          "match": ","
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.plum",
          "match": "\\b(drop|if|elif|else|while|for|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.plum",
          "match": "\\b(plant|root|branch|func|class)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.plum",
          "match": "\\b(int|float|str|bool|void)\\b"
        },
        {
          "name": "storage.type.complex.plum",
          "match": "\\b(list|dict|any)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.plum",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.plum",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.plum",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.plum",
          "match": "="
        },
        {
          "name": "keyword.operator.plum",
          "match": "\\+|-|\\*|/|%|\\^|==|!=|<=|>=|<|>|&&|\\|\\||!"
        }
      ]
    },
    "constants": {
      "name": "constant.language.plum",
      "match": "\\b(true|false|null|undefined|none)\\b"
    }
  }
}