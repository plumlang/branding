# A taste of Plumlang, for trying the highlighting.
seed math

root GREETING = "Hello"

trait Shape {
    branch area() -> float
}

tree Circle : Shape {
    radius: float
    branch area() -> float => math.PI * self.radius ** 2
}

kind Size {
    Small
    Large(over: float)
}

branch size_of(s: Shape) -> Size {
    plant a = s.area()
    if a < 10.0 {
        return Size.Small
    }
    return Size.Large(a - 10.0)
}

plant shapes: list[Shape] = [Circle(1.0), Circle(2.5)]
for s in shapes {
    plant label = match size_of(s) {
        Small => "small"
        Large(over) => "large, {over:.1} over"
    }
    drop("{GREETING}! area {s.area():.2}, {label}")  # formats after ':'
}

plant poem = """
    Roses are red,
    plums are 0x{255:x}.
    """
try {
    throw ValueError("# not a comment")
} catch e: ValueError {
    drop(e.message, poem)
}
