{
  "name": "plum-lang",
  "displayName": "Plum Language",
  "publisher": "plum-lang",
  "description": "Plumlang for VS Code: highlighting, plus diagnostics, hover, go to definition, completion, outline and formatting from the plum language server",
  "version": "0.2.0",
  "homepage": "https://plum.elixpo.com/docs/tools/lsp/",
  "repository": {
    "type": "git",
    "url": "https://github.com/plumlang/branding.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/plumlang/branding/issues"
  },
  "icon": "icons/plum-icon-32.png",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:plum"
  ],
  "contributes": {
    "commands": [
      {
        "command": "plum.runFile",
        "title": "Plum: Run File",
        "category": "Plum",
        "icon": "$(play)"
      },
      {
        "command": "plum.restartServer",
        "title": "Plum: Restart Language Server",
        "category": "Plum"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "plum.runFile",
          "when": "resourceLangId == plum"
        }
      ],
      "commandPalette": [
        {
          "command": "plum.runFile",
          "when": "editorLangId == plum"
        }
      ]
    },
    "configuration": {
      "title": "Plumlang",
      "properties": {
        "plum.path": {
          "type": "string",
          "default": "plum",
          "scope": "machine",
          "markdownDescription": "The `plum` binary the extension runs: `plum` on your `PATH` by default, or a full path such as `/usr/local/bin/plum`."
        },
        "plum.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run the language server, `plum lsp`, for diagnostics, hover, go to definition, completion, the outline and formatting. Highlighting works without it."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "plum",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "The .plum file to run."
          }
        }
      }
    ],
    "languages": [
      {
        "id": "plum",
        "aliases": [
          "Plum",
          "plum"
        ],
        "extensions": [
          ".plum"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plum",
        "scopeName": "source.plum",
        "path": "./syntaxes/plum.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "plum-icons",
        "label": "Plum Icons",
        "path": "./icons/plum-icon-theme.json"
      },
      {
        "id": "plum-icons-material",
        "label": "Plum Icons (Material)",
        "path": "./icons/material-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.22.0"
  }
}
