{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Plum",
  "scopeName": "source.plum",
  "fileTypes": [
    "plum"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#types"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "include": "#block-comment"
        },
        {
          "comment": "## lines document the declaration after them; ### is an ordinary comment.",
          "name": "comment.line.documentation.plum",
          "match": "(##)(?!#).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.plum"
            }
          }
        },
        {
          "name": "comment.line.number-sign.plum",
          "match": "(#).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.plum"
            }
          }
        }
      ]
    },
    "block-comment": {
      "comment": "#[ ... ]# nests: each #[ inside needs its own ]#.",
      "name": "comment.block.plum",
      "begin": "#\\[",
      "end": "\\]#",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.plum"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.plum"
        }
      },
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.plum",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.plum"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.plum"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.double.plum",
          "begin": "\"",
          "end": "(\")|(?=$)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.plum"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.plum"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "constant.character.escape.plum",
          "match": "\\\\(?:[ntr0\\\\\"{}]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.plum",
          "match": "\\\\."
        },
        {
          "include": "#interpolation"
        },
        {
          "name": "invalid.illegal.brace.plum",
          "match": "\\}"
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.plum",
      "contentName": "meta.embedded.line.plum",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.plum"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.plum"
        }
      },
      "patterns": [
        {
          "include": "#format-spec"
        },
        {
          "include": "#interpolation-code"
        }
      ]
    },
    "format-spec": {
      "comment": "A ':' at the top of an interpolation starts a format: {price:.2}, {name:<10}.",
      "match": "(:)([^{}\\\"]*)(?=\\})",
      "captures": {
        "1": {
          "name": "punctuation.separator.format.plum"
        },
        "2": {
          "name": "constant.other.format-spec.plum"
        }
      }
    },
    "interpolation-code": {
      "patterns": [
        {
          "include": "#groups"
        },
        {
          "include": "#code"
        }
      ]
    },
    "groups": {
      "comment": "Brackets inside an interpolation, matched so that a '}' or ':' inside them stays code.",
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.braces.begin.plum"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.end.plum"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-code"
            }
          ]
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.parens.begin.plum"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parens.end.plum"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-code"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.brackets.begin.plum"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.brackets.end.plum"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-code"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(branch)\\s+((?!(?:and|as|bad|branch|break|catch|continue|else|false|finally|for|good|if|in|is|kind|match|none|not|or|plant|return|root|seed|self|spawn|super|throw|trait|tree|true|try|weak|while)\\b)[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.plum"
            },
            "2": {
              "name": "entity.name.function.plum"
            }
          }
        },
        {
          "match": "\\b(tree|trait|kind)\\s+((?!(?:and|as|bad|branch|break|catch|continue|else|false|finally|for|good|if|in|is|kind|match|none|not|or|plant|return|root|seed|self|spawn|super|throw|trait|tree|true|try|weak|while)\\b)[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.plum"
            },
            "2": {
              "name": "entity.name.type.plum"
            }
          }
        },
        {
          "match": "\\b(root)\\s+((?!(?:and|as|bad|branch|break|catch|continue|else|false|finally|for|good|if|in|is|kind|match|none|not|or|plant|return|root|seed|self|spawn|super|throw|trait|tree|true|try|weak|while)\\b)[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.constant.plum"
            },
            "2": {
              "name": "variable.other.constant.plum"
            }
          }
        },
        {
          "match": "\\b(plant)\\s+((?!(?:and|as|bad|branch|break|catch|continue|else|false|finally|for|good|if|in|is|kind|match|none|not|or|plant|return|root|seed|self|spawn|super|throw|trait|tree|true|try|weak|while)\\b)[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.variable.plum"
            },
            "2": {
              "name": "variable.other.declaration.plum"
            }
          }
        },
        {
          "match": "\\b(seed)\\s+(\\.{1,2}/[^\\s#]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.plum"
            },
            "2": {
              "name": "string.unquoted.path.plum"
            }
          }
        },
        {
          "match": "\\b(seed)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.plum"
            },
            "2": {
              "name": "entity.name.namespace.plum"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.plum",
          "match": "\\b(plant|root|branch|tree|trait|kind)\\b"
        },
        {
          "name": "keyword.control.import.plum",
          "match": "\\bseed\\b"
        },
        {
          "name": "keyword.control.conditional.plum",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.plum",
          "match": "\\b(for|while|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.plum",
          "match": "\\breturn\\b"
        },
        {
          "name": "keyword.control.exception.plum",
          "match": "\\b(throw|try|catch|finally)\\b"
        },
        {
          "name": "keyword.control.task.plum",
          "match": "\\bspawn\\b"
        },
        {
          "name": "keyword.operator.logical.plum",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.word.plum",
          "match": "\\b(in|is|as)\\b"
        },
        {
          "name": "storage.modifier.weak.plum",
          "match": "\\bweak\\b"
        },
        {
          "name": "variable.language.plum",
          "match": "\\b(self|super)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.plum",
          "match": "\\b(good|bad|true|false)\\b"
        },
        {
          "name": "constant.language.none.plum",
          "match": "\\bnone\\b"
        },
        {
          "name": "variable.language.wildcard.plum",
          "match": "\\b_\\b"
        },
        {
          "name": "variable.other.constant.plum",
          "match": "\\b_*[A-Z][A-Z0-9_]*\\b(?![a-z])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.plum",
          "match": "\\b(drop|ask|len|type_of|assert|exit|int|float|str|byte|set)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.plum",
          "match": "\\b(int|float|bool|str|byte|list|map|set|Channel|Task|Json)\\b"
        },
        {
          "name": "entity.name.type.plum",
          "match": "\\b_*[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.plum",
          "match": "\\b0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b"
        },
        {
          "name": "constant.numeric.octal.plum",
          "match": "\\b0[oO][0-7](?:_?[0-7])*\\b"
        },
        {
          "name": "constant.numeric.binary.plum",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.float.plum",
          "match": "\\b[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[eE][+-]?[0-9](?:_?[0-9])*)\\b"
        },
        {
          "name": "constant.numeric.integer.plum",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.plum"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.plum",
          "match": "//=|\\*\\*=|<<=|>>=|[-+*/%&|^]="
        },
        {
          "name": "keyword.operator.comparison.plum",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arrow.plum",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.assignment.plum",
          "match": "="
        },
        {
          "name": "keyword.operator.optional.plum",
          "match": "\\?\\?|\\?\\.|\\?"
        },
        {
          "name": "keyword.operator.range.plum",
          "match": "\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.plum",
          "match": "\\*\\*|//|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.plum",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.plum",
          "match": "[<>]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.plum",
          "match": ","
        },
        {
          "name": "punctuation.accessor.plum",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.plum",
          "match": ":"
        },
        {
          "name": "punctuation.bracket.plum",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
